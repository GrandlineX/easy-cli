{
  "name": "@grandlinex/easy-cli",
  "version": "3.0.3",
  "description": "Cli lib to perform common tasks",
  "private": false,
  "keywords": [
    "TypeDoc",
    "GrandLineX",
    "CLI"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && npm pack",
    "lint": "eslint src",
    "interactive": "tsx src/cli.ts --interactive",
    "progress": "tsx src/cli.ts debug --progress",
    "help": "tsx src/cli.ts --help",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "makeDocs": "typedoc"
  },
  "author": {
    "name": "Elschnagoo"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "@grandlinex/core": "3.0.0",
    "moment": "2.30.1"
  },
  "peerDependencies": {
    "@inquirer/prompts": "8.7.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.9.0",
    "eslint-plugin-prettier": "5.2.1",
    "prettier": "3.5.3",
    "tsx": "4.23.12",
    "typedoc": "0.28.20",
    "tsdown": "0.22.14",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "6.0.3"
  },
  "homepage": "https://www.grandlinex.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/GrandlineX/easy-cli.git"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
